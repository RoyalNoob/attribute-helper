<?xml version="1.0" encoding="UTF-8"?>
<pythonPanelDocument>
  <interface name="attribute_helper" label="Attribute Helper" icon="MISC_python" showNetworkNavigationBar="false" help_url="">
    <script><![CDATA[
from attribute_helper.ui.panel import Panel

panel = None


def onCreateInterface():
    global panel
    panel = Panel()
    return panel


def onDestroy():
    if panel is not None:
        panel.shutdown()
]]></script>
    <includeInPaneTabMenu menu_position="0" create_separator="false"/>
    <includeInToolbarMenu menu_position="0" create_separator="false"/>
    <help><![CDATA[Shows where each SOP attribute is born, written, passed through, and deleted.
Tick an attribute to draw its lifetime on the network editor.]]></help>
  </interface>
</pythonPanelDocument>
